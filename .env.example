# Copy to .env and edit. Only the first two blocks need attention.

# --- Initial admin account -------------------------------------------------
# Created on first start if it does not exist. Later password changes made in
# the UI are kept. Both lines can be removed after the first start.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Front door (pick one) ---------------------------------------------------
# Recommended: Cloudflare Tunnel.  docker compose --profile tunnel up -d
# Token from Cloudflare Zero Trust > Networks > Tunnels. No inbound ports needed.
TUNNEL_TOKEN=
CLIENT_IP_HEADER=Cf-Connecting-Ip

# Alternative: Caddy with automatic HTTPS.  docker compose --profile caddy up -d
# Point a DNS A record at this server, open ports 80/443, then use instead:
# DOMAIN=clip.example.com
# CLIENT_IP_HEADER=X-Forwarded-For

# --- Sessions --------------------------------------------------------------
# Idle timeout; every visit extends it. 720h = 30 days.
SESSION_TTL=720h
# Keep true in production. false only for plain-HTTP testing on a LAN IP.
COOKIE_SECURE=true

# --- Limits ------------------------------------------------------------------
# Cloudflare's free plan rejects request bodies over 100 MB.
MAX_UPLOAD_MB=100
# Total file storage per user, 0 = unlimited.
USER_QUOTA_MB=2048
MAX_CLIP_KB=256
CLIP_HISTORY_LIMIT=200
# Auto-delete files / clips older than N days, 0 = keep forever.
FILE_RETENTION_DAYS=0
CLIP_RETENTION_DAYS=0

# --- Brute-force protection ------------------------------------------------
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW=15m

# Host port bound on 127.0.0.1 (for a host-level reverse proxy).
APP_PORT=8080
